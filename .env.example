# Backend Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration (Required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_db

# JWT Secret Key (Required - change in production!)
SECRET_KEY=your-secret-key-change-in-production

# JWT Algorithm (Optional, defaults to HS256)
ALGORITHM=HS256

# Access Token Expiration (Optional, in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Connection Timeout (Optional, in seconds)
DB_CONNECT_MAX_SECONDS=60

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Development/Production Mode
ENVIRONMENT=development

# CORS Origins (Optional, comma-separated)
# In production, set to your frontend domain(s)
# Example: CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=*
